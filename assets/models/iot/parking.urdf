<?xml version="1.0"?>
<robot name="parking_gate">
  <link name="world"/>
  <link name="post">
    <visual>
      <geometry>
        <box size="0.12 0.12 1.4"/>
      </geometry>
      <material name="post_mat">
        <color rgba="0.35 0.38 0.42 1"/>
      </material>
    </visual>
  </link>
  <joint name="post_world" type="fixed">
    <parent link="world"/>
    <child link="post"/>
    <origin xyz="0 0 0.7" rpy="0 0 0"/>
  </joint>

  <link name="barrier">
    <visual>
      <origin xyz="1.1 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.2 0.08 0.14"/>
      </geometry>
      <material name="barrier_mat">
        <color rgba="0.18 0.85 0.55 1"/>
      </material>
    </visual>
  </link>
  <joint name="barrier_joint" type="revolute">
    <parent link="post"/>
    <child link="barrier"/>
    <origin xyz="0 0 0.55" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.1" effort="0" velocity="0"/>
  </joint>

  <link name="camera">
    <visual>
      <geometry>
        <mesh filename="package://iot_description/meshes/camera_assy.dae" scale="0.85 0.85 0.85"/>
      </geometry>
    </visual>
  </link>
  <joint name="camera_mount" type="fixed">
    <parent link="post"/>
    <child link="camera"/>
    <origin xyz="0.08 0 1.0" rpy="0 0.4 0"/>
  </joint>

  <link name="lidar">
    <visual>
      <geometry>
        <mesh filename="package://iot_description/meshes/rplidar_c1.dae" scale="0.9 0.9 0.9"/>
      </geometry>
    </visual>
  </link>
  <joint name="lidar_mount" type="fixed">
    <parent link="post"/>
    <child link="lidar"/>
    <origin xyz="-0.06 0 1.15" rpy="0 0 0"/>
  </joint>
</robot>
