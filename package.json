{
  "name": "physical-ai-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Three.js Physical AI portfolio",
  "scripts": {
    "lint": "eslint js eslint.config.js -f compact",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:css && npm run format:check",
    "test:e2e": "node scripts/test-exit-flow.mjs",
    "test:verify": "node scripts/verify-journey-sprint.mjs",
    "test:all": "npm run test:e2e && npm run test:verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joey114132/physical-ai-portfolio.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-formatter-compact": "^9.0.1",
    "globals": "^17.6.0",
    "playwright": "^1.49.1",
    "prettier": "^3.8.3",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0"
  }
}
